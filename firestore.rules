rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function hasEmail() {
      return isSignedIn() && request.auth.token.email != null;
    }

    function isAllowedUser() {
      return hasEmail()
        && exists(/databases/$(database)/documents/allowedUsers/$(request.auth.token.email));
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidCategoryOrder(categoryOrder) {
      return categoryOrder is list
        && categoryOrder.size() == 9
        && categoryOrder.hasAll([
          'information_device',
          'smartphone',
          'audio_visual',
          'air_conditioning',
          'living_appliance',
          'cooking_appliance',
          'beauty_health',
          'car',
          'other'
        ]);
    }

    match /allowedUsers/{email} {
      allow get: if hasEmail() && request.auth.token.email == email;
      allow list, create, update, delete: if false;
    }

    match /users/{userId}/durableGoodsItems/{itemId} {
      allow read, create, update, delete: if isOwner(userId) && isAllowedUser();
    }

    match /users/{userId}/pcItems/{pcId} {
      allow read, create, update, delete: if isOwner(userId) && isAllowedUser();
    }

    match /users/{userId}/settings/{settingId} {
      allow get: if settingId == 'ui' && isOwner(userId) && isAllowedUser();
      allow create, update: if settingId == 'ui'
        && isOwner(userId)
        && isAllowedUser()
        && request.resource.data.keys().hasOnly(['categoryOrder', 'updatedAt'])
        && isValidCategoryOrder(request.resource.data.categoryOrder)
        && request.resource.data.updatedAt == request.time;
      allow list, delete: if false;
    }
  }
}
